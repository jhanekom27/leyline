Output docs/assets/leyline-demo.gif

Require tmux
Require bash

Set Shell "bash"
Set FontSize 16
Set Width 1920
Set Height 900
Set Theme "Catppuccin Frappe"
Set Padding 16
Set Margin 24
Set MarginFill "#1e1e2e"
Set WindowBar Colorful
Set Framerate 12
Set TypingSpeed 0ms
Set WaitTimeout 15s

Hide
Type "tmux -L leyline-vhs-demo attach -t leyline-demo"
Enter
Wait+Screen /#general/
Show

Sleep 37s
